{
    "name": "xml-checker-barb",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "license": "UNLICENSED",
    "main": "dist/remoteEntry.js",
    "scripts": {
        "prebuild": "tsc",
        "build": "webpack --mode=production && webpack --mode=development",
        "start": "webpack serve --mode=development",
        "extract-i18n": "extract-i18n i18n.config.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "postinstall": "one-host-build install-remote-module-types",
        "integration:local": "MODULE_OVERRIDE_NAME=`cat package.json | jq -r '.onehost.scope'` MODULE_OVERRIDE_BRANCH_NAME=3002 ./node_modules/.bin/ts-node --project tsconfig.testcafe.json ./testcafe/runner.ts --concurrency=1",
        "integration:qa": "./node_modules/.bin/ts-node --project tsconfig.testcafe.json ./testcafe/runner.ts --concurrency=1",
        "integration:ci": "./node_modules/.bin/ts-node --project tsconfig.testcafe.json ./testcafe/runner.ts --browsers=chrome --headless --quarantine=false"
    },
    "devDependencies": {
        "@apollo/client": "3.9.6",
        "@babel/core": "^7.13.14",
        "@babel/eslint-parser": "^7.14.9",
        "@babel/plugin-transform-runtime": "^7.13.10",
        "@babel/preset-env": "^7.13.12",
        "@babel/preset-react": "^7.13.13",
        "@babel/preset-typescript": "^7.13.0",
        "@babel/runtime": "^7.13.10",
        "@datadog/browser-rum": "5.29.1",
        "@emotion/react": "11.10.5",
        "@emotion/styled": "11.10.5",
        "@indeed/browserslist-config-frontend": "^1.2.0",
        "@indeed/eslint-plugin-one-host": "^3.1.0",
        "@indeed/frontend-proctor-utils": "4.3.2",
        "@indeed/ifl-components": "6.15.2",
        "@indeed/ifl-css": "6.15.2",
        "@indeed/ifl-icons": "6.15.2",
        "@indeed/ifl-themes": "6.15.2",
        "@indeed/ifl-tokens": "6.15.2",
        "@indeed/one-host-analytics": "2.23.4",
        "@indeed/one-host-app-context": "18.5.0",
        "@indeed/one-host-build": "^15.1.1",
        "@indeed/one-host-i18n": "3.5.6",
        "@indeed/one-host-page-title-management": "1.9.1",
        "@indeed/one-host-remote-module": "4.0.1",
        "@indeed/smb-testcafe-common-page-objects": "^1.33.0",
        "@indeed/storybook-addon-translations": "^8.0.0",
        "@indeed/storybook-one-host-preset": "0.1.1",
        "@indeed/testcafe-common-logger-util": "^1.9.2",
        "@indeed/testcafe-runner": "^1.3.6",
        "@storybook/addon-actions": "^7.5.3",
        "@storybook/addon-essentials": "^7.5.3",
        "@storybook/addon-interactions": "^7.5.3",
        "@storybook/addon-links": "^7.5.3",
        "@storybook/react": "^7.5.3",
        "@storybook/react-webpack5": "^7.5.3",
        "@storybook/testing-library": "0.2.2",
        "@testing-library/jest-dom": "^5.11.10",
        "@testing-library/react": "^13.3.0",
        "@testing-library/user-event": "^13.1.1",
        "@types/react": "^18.0.18",
        "@types/react-dom": "^18.0.6",
        "@types/react-router-dom": "^5.1.7",
        "@typescript-eslint/eslint-plugin": "^4.20.0",
        "@typescript-eslint/parser": "^5.17.0",
        "babel-eslint": "^10.1.0",
        "babel-loader": "^8.2.2",
        "eslint": "^7.23.0",
        "eslint-config-prettier": "^7.2.0",
        "eslint-plugin-compat": "^3.9.0",
        "eslint-plugin-prettier": "^3.3.1",
        "eslint-plugin-storybook": "^0.6.15",
        "graphql": "^15.5.0",
        "husky": "^4.3.8",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-junit": "^12.0.0",
        "lint-staged": "^10.5.4",
        "prettier": "^2.3.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-router": "^5.3.3",
        "react-router-dom": "5.3.4",
        "storybook": "^7.5.3",
        "testcafe": "^2.0.2",
        "typescript": "^5.1.6",
        "webpack": "^5.81.0",
        "webpack-bundle-analyzer": "^4.4.0",
        "webpack-cli": "^4.9.1",
        "webpack-dev-server": "^4.10.1"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{json,yaml,md}": "prettier --write",
        "*.{js,ts,tsx}": "eslint --fix"
    },
    "onehost": {
        "scope": "xml-checker-barb",
        "ownerSlackSupportChannel": "xml-fixer-barb",
        "isPrivilegedIpOnly": false
    }
}
